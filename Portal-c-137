local function makeGun()
    local tool = Instance.new("Tool")
    tool.Name = " "
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.4, 1.2, 0.4)
    handle.Color = Color3.fromRGB(160, 160, 165)
    handle.Material = Enum.Material.SmoothPlastic
    handle.Parent = tool

    local body = Instance.new("Part")
    body.Size = Vector3.new(0.7, 0.45, 1.5)
    body.Color = Color3.fromRGB(175, 175, 180)
    body.Material = Enum.Material.SmoothPlastic
    body.CanCollide = false
    body.Parent = tool

    local w1 = Instance.new("Weld")
    w1.Part0 = handle
    w1.Part1 = body
    w1.C0 = CFrame.new(0, 0.6, -0.4)
    w1.Parent = handle

    local tube = Instance.new("Part")
    tube.Size = Vector3.new(0.4, 0.65, 0.4)
    tube.Color = Color3.fromRGB(0, 255, 70)
    tube.Material = Enum.Material.Neon
    tube.Transparency = 0.2
    tube.CanCollide = false
    tube.Parent = tool

    local w2 = Instance.new("Weld")
    w2.Part0 = body
    w2.Part1 = tube
    w2.C0 = CFrame.new(0, 0.5, 0.1)
    w2.Parent = body

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(0, 255, 70)
    light.Range = 5
    light.Brightness = 1.2
    light.Parent = tube

    return tool
end

